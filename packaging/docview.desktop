[Desktop Entry]
Type=Application
Name=docview
GenericName=Document Viewer
Comment=Minimal, low-memory PDF viewer
Exec=docview %f
Icon=docview
Terminal=false
Categories=Office;Viewer;Graphics;
MimeType=application/pdf;application/x-pdf;
Keywords=pdf;document;viewer;reader;
StartupWMClass=dev.docview.app
